<?xml version="1.0"?>
<robot name="robotic_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Material definitions -->
<material name="blue">
    <color rgba="0 0 0.8 1"/>
</material>

<material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
</material>

<material name="red">
    <color rgba="0.8 0 0 1"/>
</material>

<material name="green">
    <color rgba="0 0.8 0 1"/>
</material>

<material name="orange">
    <color rgba="1 0.5 0 1"/>
</material>

<xacro:macro name="dh_joint" params="name parent child a d alpha lower upper effort velocity">
    <joint name="${name}" type="revolute">
        <origin xyz="${a} 0 ${d}" rpy="${alpha} 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
        <parent link="${parent}"/>
        <child link="${child}"/>
    </joint>
</xacro:macro>

<link name="world"/>

<link name="base_link">
    <collision>
        <geometry>
            <cylinder length="0.15" radius="0.08"/>
        </geometry>
    </collision>
    <visual>
        <geometry>
            <cylinder length="0.15" radius="0.08"/>
        </geometry>
        <material name="blue"/>
    </visual>
    <inertial>
        <origin xyz="0 0 0.075" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" 
                 iyy="0.01" iyz="0" izz="0.005"/>
    </inertial>
</link>

<joint name="world_to_base" type="fixed">
    <origin xyz="0.7 0 0.2" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
</joint>

<!-- joint1-->
<xacro:dh_joint name="joint1" parent="base_link" child="link1"
                a="0" d="0.1" alpha="0"
                lower="-3.14159" upper="3.14159" 
                effort="10.0" velocity="1.0"/>

<link name="link1">
    <collision>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
    </collision>
    <visual>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
        <material name="red"/>
    </visual>
    <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" 
                 iyy="0.0001" iyz="0" izz="0.0003"/>
    </inertial>
</link>

<!-- joint2-->
 <xacro:dh_joint name="joint2" parent="link1" child="link2"
                a="0.1" d="0.3" alpha="${pi/2}" 
                lower="0" upper="${pi}" 
                effort="10.0" velocity="1.0"/>

<link name="link2">
    <collision>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
    </collision>
    <visual>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
        <material name="green"/>
    </visual>
    <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" 
                 iyy="0.0001" iyz="0" izz="0.0003"/>
    </inertial>
</link>

<!-- joint3-->
 <xacro:dh_joint name="joint3" parent="link2" child="link3"
                a="0.3" d="0.08" alpha="0" 
                lower="${pi/2}" upper="${3*pi/2}" 
                effort="10.0" velocity="1.0"/>

<link name="link3">
    <collision>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
    </collision>
    <visual>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
        <material name="orange"/>
    </visual>
    <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" 
                 iyy="0.0001" iyz="0" izz="0.0003"/>
    </inertial>
</link>

<!-- joint4-->
 <xacro:dh_joint name="joint4" parent="link3" child="link4"
                a="0.25" d="0.15" alpha="${-pi/2}" 
                lower="0" upper="${2*pi}" 
                effort="10.0" velocity="1.0"/>

<link name="link4">
    <collision>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
    </collision>
    <visual>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
        <material name="grey"/>
    </visual>
    <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" 
                 iyy="0.0001" iyz="0" izz="0.0003"/>
    </inertial>
</link>

<!-- joint5-->
 <xacro:dh_joint name="joint5" parent="link4" child="link5"
                a="0" d="0.1" alpha="${-pi/2}" 
                lower="${pi/2}" upper="${3*pi/2}" 
                effort="10.0" velocity="1.0"/>

<link name="link5">
    <collision>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
    </collision>
    <visual>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
        <material name="blue"/>
    </visual>
    <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" 
                 iyy="0.0001" iyz="0" izz="0.0003"/>
    </inertial>
</link>

<!-- joint6 -->
 <xacro:dh_joint name="joint6" parent="link5" child="link6"
                a="0.15" d="0.15" alpha="${pi/2}" 
                lower="-3.14159" upper="3.14159" 
                effort="10.0" velocity="1.0"/>

<link name="link6">
    <collision>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
    </collision>
    <visual>
        <geometry>
            <box size="0.05 0.06 0.12"/>
        </geometry>
        <material name="green"/>
    </visual>
    <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" 
                 iyy="0.0001" iyz="0" izz="0.0003"/>
    </inertial>
</link>

<!-- joint7-->
 <joint name="joint7" type="fixed">
    <!-- 沿z₆轴偏移d₇距离，假设d₇=0.1 -->
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="end_effector"/>
</joint>

<!-- end effector -->
<link name="end_effector">
    <collision>
        <geometry>
            <box size="0.04 0.04 0.04"/>
        </geometry>
    </collision>
    <visual>
        <geometry>
            <box size="0.04 0.04 0.04"/>
        </geometry>
        <material name="red"/>
    </visual>
    <inertial>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" 
                 iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
</link>
    
</robot>