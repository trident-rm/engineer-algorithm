<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="uc_planning_urdf">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import uc_planning_urdf urdf file -->
    <xacro:include filename="$(find uc_planning_urdf)/urdf/uc_planning_urdf.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="uc_planning_urdf.ros2_control.xacro" />


    <xacro:uc_planning_urdf_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
