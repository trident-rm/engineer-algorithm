<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robo_arm3">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import robo_arm3 urdf file -->
    <xacro:include filename="$(find robo_arm3)/urdf/robo_arm3.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="robo_arm3.ros2_control.xacro" />


    <xacro:robo_arm3_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
